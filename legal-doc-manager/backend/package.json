{
    "name": "legal-doc-manager-backend",
    "version": "1.0.0",
    "description": "Sistema de gestión documental para bufetes legales",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "init-db": "node src/models/initDB.js",
        "setup": "node scripts/setup.js",
        "backup": "node scripts/backup.js",
        "cleanup-logs": "node scripts/cleanupLogs.js",
        "test": "jest",
        "lint": "eslint src/",
        "format": "prettier --write src/"
    },
    "keywords": [
        "legal",
        "document",
        "management",
        "lawyer",
        "secure"
    ],
    "author": "Tu Nombre",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "sqlite3": "^5.1.6",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.1",
        "multer": "^1.4.5-lts.1",
        "crypto-js": "^4.1.1",
        "dotenv": "^16.3.1",
        "cors": "^2.8.5",
        "helmet": "^7.0.0",
        "express-rate-limit": "^6.10.0",
        "socket.io": "^4.6.1",
        "winston": "^3.10.0",
        "moment": "^2.29.4",
        "express-validator": "^7.0.1"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "jest": "^29.6.4",
        "supertest": "^6.3.3",
        "eslint": "^8.48.0",
        "prettier": "^3.0.3"
